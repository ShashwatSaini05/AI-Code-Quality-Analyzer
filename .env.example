# ===========================================
# CodeSage AI — Environment Configuration
# ===========================================

# Application
APP_NAME=CodeSage AI
APP_ENV=development
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production
API_VERSION=v1

# Database
DATABASE_URL=postgresql+asyncpg://codesage:codesage_pass@localhost:5432/codesage_db
DATABASE_URL_SYNC=postgresql://codesage:codesage_pass@localhost:5432/codesage_db

# SQLite fallback (for development without PostgreSQL)
SQLITE_URL=sqlite+aiosqlite:///./codesage.db

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# OAuth - GitHub
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# OAuth - Google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Frontend
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ML Models
ML_MODEL_PATH=./ml/models
EMBEDDINGS_MODEL=all-MiniLM-L6-v2

# LLM (Optional - for AI Chat)
LLM_PROVIDER=none
OPENAI_API_KEY=your-openai-api-key
GOOGLE_AI_API_KEY=your-google-ai-api-key
